# API用 .htaccess
# /api/ へのアクセスで index.php を実行
DirectoryIndex index.php

# ディレクトリ一覧を無効化
Options -Indexes

# 内部ライブラリ・設定・保守ツールはURLから直接開かせない
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(lib|tools|migrations)(/|$) - [F,L]
    RewriteRule ^(config|config\.sample|service-account\.example)\. - [F,L]
</IfModule>

# JSON レスポンスのための CORS ヘッダー（必要に応じて）
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type"
</IfModule>
